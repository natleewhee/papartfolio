FINNHUB_API_KEY=your_finnhub_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional — IBKR Flex Web Service (holdings reconciliation after market close).
# Leave both unset to disable this feature entirely.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Optional — Anthropic API key (AI market brief with web search, in the daily
# report and /brief). Leave unset to disable this feature entirely.
ANTHROPIC_API_KEY=
